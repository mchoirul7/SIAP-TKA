SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
ENTITLEMENT_COOKIE_SECRET=change-me-to-a-long-random-string

# Secret key Supabase, hanya dipakai route server untuk kode murid, akses, dan
# nilai. Jangan pernah diberi awalan NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Alamat produksi. Menjadi dasar alamat kanonis, peta situs, dan pratinjau
# tautan di WhatsApp serta media sosial. Tanpa ini dipakai alamat Vercel.
NEXT_PUBLIC_SITE_URL=https://siap-tka-one.vercel.app

# Kode dari Google Search Console. Boleh dikosongkan sampai situs didaftarkan.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Password halaman /admin untuk membuat kode murid dan menambah paket.
ADMIN_PASSWORD=ganti-dengan-password-panjang
